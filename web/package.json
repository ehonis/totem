{
  "name": "totem-dashboard",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ehonis/Totem.git",
    "directory": "web"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "test": "npm run test:unit && npm run test:todos",
    "test:unit": "node --experimental-strip-types --test src/components/*.test.ts",
    "test:todos": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.0.18",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@tabler/icons-react": "^3.46.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.10.0",
    "marked": "^12.0.2",
    "marked-highlight": "^2.1.3",
    "onnxruntime-web": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "simple-icons": "^16.24.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
