{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Totem",
  "version": "0.1.0",
  "identifier": "app.totem.desktop",
  "build": {
    "frontendDist": "../setup"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "category": "Productivity",
    "shortDescription": "Totem, in its own window",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
