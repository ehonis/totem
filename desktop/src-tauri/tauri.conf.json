  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGOUEyQTBCOURCQUQyRDQKUldUVTBycWRDeXFhSHlwWkxwNXNiRVJZelpUWUZPdE1qaWtvaXlQTnpLWlk1Sm95cUdQdkxVZXoK",
