# Copy to .env and fill in. .env is gitignored. Loaded via `node --env-file=.env`
# (npm start and the systemd unit do this; docker compose reads it as env_file).
#
# Nothing here is required for a first run: `npm start` with no .env gives a
# working, empty Totem. Sign-in, AI and integrations can all be set up in the
# browser. Anything set here overrides what was saved in the dashboard.

# --- Sign-in and this install ---
# password (default): one owner account, created through the one-time setup link
#   the server prints on first start; sessions are signed httpOnly cookies.
# proxy: trust every request, because an auth proxy in front (Cloudflare Access,
#   oauth2-proxy, Tailscale Serve with identity headers, ...) already decided.
#   Only safe when nothing can reach BRIDGE_PORT without passing that proxy.
# TOTEM_AUTH=password
# PUBLIC_URL=https://totem.example.com   # where you open Totem from other devices;
                                         # used for the setup link and OAuth redirect URIs
# OWNER_NAME=                            # how the assistant and greetings refer to you
# TOTEM_TRUST_PROXY=                     # true: trust X-Forwarded-For/CF-Connecting-IP for the
                                         # login throttle from any peer. Unset: trusted only from
                                         # a proxy on this machine (cloudflared, local nginx).
# TOTEM_ALLOW_UI_EXEC_CONFIG=false       # true lets the dashboard change agent binary paths,
                                         # config dirs, launch args, per-account env and usage
                                         # profile paths. Off: edit data/provider-config.json and
                                         # data/ai-usage.json on the box instead.
# AUTH_FILE=                             # default data/auth.json (0600)

# --- Agent provider (runtime-selectable in the Connections tab) ---
# The default provider and model are normally picked in Settings -> AI, which
# saves them to data/provider-config.json; these are first-run fallbacks.
AGENT_BACKEND=codex                 # boot/fallback default: codex | cursor | claude | opencode
AGENT_MODEL=gpt-5.6-sol             # codex model; must be a live id (see CODEX_MODEL_ALLOWLIST)
# API keys for the agent CLIs. Optional when the CLI is signed in with a
# subscription. Can also be entered in Settings -> AI (stored in
# data/ai-settings.json, 0600); a value here wins.
# ANTHROPIC_API_KEY=                # Claude Code, OpenCode
# OPENAI_API_KEY=                   # Codex, OpenCode
# CURSOR_API_KEY=                   # Cursor Agent
# CODEX_MODEL_ALLOWLIST=            # optional: pin the selectable codex models to these slugs.
                                    # Default is every model in codex's newest generation.
CLAUDE_MODEL=                       # optional Claude Code model override
OPENCODE_MODEL=                     # optional OpenCode model, e.g. anthropic/claude-sonnet-4
AGENT_CWD=/home/you/projects        # the agent's working root (repo access); absolute, no ~ or $HOME
AGENT_SANDBOX=workspace-write       # codex only: read-only | workspace-write | danger-full-access
AGENT_TIMEOUT_MS=180000             # kill an agent run after this long
# MEMORY_ROOT=                      # optional; default data/brain (private Markdown second brain, gitignored). See brain.example/ for the starter structure.
# PROVIDER_CONFIG_FILE=             # optional; default data/provider-config.json (gitignored)
# MCP_MANIFEST_FILE=                # optional; default data/mcp-manifest.json (gitignored)
# HABITS_FILE=                      # optional; default data/habits.json (gitignored) — the in-house habit tracker's single JSON store (dashboard + agent both use it)
# TODO_DATABASE_FILE=               # optional; default data/todos.db (gitignored)
# TODO_BACKUP_DIR=                  # optional; default data/todo-backups (gitignored)

# --- Google Sheet task sync (optional; docs/task-sheet.md) ---
# Mirrors one shared spreadsheet of action items with Ventures tasks. Off until
# all of TASK_SHEET_ID, TASK_SHEET_ASSIGNEES and the credentials file are set.
# Dedicated service-account JSON. Do not reuse Google Calendar's user OAuth tokens.
# Share only that spreadsheet with this service account as Editor.
# Keep the JSON under secrets/ (gitignored) and mode 0600.
GOOGLE_SHEETS_CREDENTIALS_FILE=     # env only: the dashboard shows whether it exists, not the path
# TASK_SHEET_ID=                    # the long id in the sheet's URL
# TASK_SHEET_TAB=Action Items
# TASK_SHEET_ASSIGNEES=             # Who-column values that mean you, e.g. "Alex,Alex & Sam"
# TASK_SHEET_TITLE=                 # optional: refuse the sheet unless its title matches
# TASK_SHEET_GID=0                  # optional: numeric id of the tab

# --- GitHub App for the todo connector (docs/github-app.md) ---------------
# With these set, the GitHub task connector mints its own installation tokens.
# Unset, it falls back to the `gh` CLI and borrows whatever personal token is
# logged in on this machine. Run scripts/connect-todo-sources.sh to set them up.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=        # e.g. secrets/github-app.pem, mode 0600
GITHUB_APP_INSTALLATION_ID=         # optional; discovered when the App is installed once
GITHUB_ASSIGNEE_LOGIN=              # optional; the login "assigned to me" means,
                                    # defaults to the account the App is installed on
# GITHUB_TODOS_SYNC_ENABLED=false   # seed default for the GitHub task sync job when no
                                    # App is configured: true opts in to borrowing the gh
                                    # CLI's login. A configured App turns it on by itself.

# --- HTTP endpoint (the iOS Shortcut posts here over Tailscale) ---
BRIDGE_SECRET=                      # optional long random string for machine callers (iOS Shortcut,
                                    # MCP gateway, sibling apps): `Authorization: Bearer <secret>`.
                                    # Empty disables bearer auth; the dashboard uses sign-in.
BRIDGE_PORT=8787

# --- Web terminal (docs/terminal.md) ---------------------------------------
# A real login shell in the dashboard, toggled with Ctrl+` from anywhere.
# OFF by default: with this false, no PTY is spawned and the WebSocket route
# does not exist. It is the same authority the agent CLIs already have, but it
# is a direct shell on a publicly-reachable host, so turn it on deliberately.
TERMINAL_ENABLED=false
# Shell for terminal sessions. Default: $SHELL, then /bin/bash. Run with -l so
# it sources your real profile (PATH, aliases, prompt).
TERMINAL_SHELL=
# Working directory for new sessions. Default: your home directory.
TERMINAL_CWD=
# Concurrent live shells.
TERMINAL_MAX_SESSIONS=8
# Replay buffer per session, in bytes. Held in memory, so the worst case is
# this times TERMINAL_MAX_SESSIONS.
TERMINAL_SCROLLBACK_BYTES=524288

# NOTE: The scheduled-job, weather, and news settings below are FIRST-RUN DEFAULTS
# only. Once the bridge runs they live in the app: the Studio → Jobs tab (every
# scheduled job, persisted to data/jobs.json) and the Connections tab's "Built-in
# data" section (weather, news, persisted to data/studio-state.json). Editing them
# there overrides these values; changing them here afterwards has no effect unless
# the store is missing that key. MORNING_BRIEFING_TZ is the exception — it's read
# straight from the env, and it's the timezone every job's clock time is in.
#
# Full job-system reference, including the schedule types and how a missed run is
# caught up: docs/jobs.md.
#
# Optional off-box delivery for job failures. Any endpoint that accepts a POST with
# a text body works — the message is the body and the title rides in a `Title`
# header, which is the shape ntfy and Pushover both take. Unset means in-app only.
# NOTIFY_WEBHOOK_URL=https://ntfy.sh/your-private-topic

# --- Morning briefing (default for Studio → Jobs → Daily brief) ---
MORNING_BRIEFING_ENABLED=false      # seed default; toggle it in Studio → Jobs
MORNING_BRIEFING_TIME=07:30         # seed default run time; HH:MM in MORNING_BRIEFING_TZ
MORNING_BRIEFING_TZ=America/New_York # timezone for every job clock time (env-only)

# --- Nightly Plaud journal ingest (default for Studio → Jobs → Journal ingest) ---
JOURNAL_INGEST_ENABLED=false        # seed default; toggle it in Studio → Jobs
JOURNAL_INGEST_TIME=07:00           # seed default run time; keep it before the briefing
# JOURNAL_STATE_FILE=                # optional; default data/journal-ingest-state.json (gitignored)

# --- Voice journal (Productivity → Journal) ---
# Recordings are transcribed on the box by whisper.cpp — run scripts/install-whisper.sh once.
# These are the paths that script installs to; only set them if you chose another prefix/model.
# JOURNAL_WHISPER_BIN=~/.local/share/totem/whisper/bin/whisper-cli
# JOURNAL_WHISPER_MODEL=~/.local/share/totem/whisper/models/ggml-small.en.bin
# JOURNAL_FFMPEG_BIN=                 # optional; default is the static binary from the ffmpeg-static package
# JOURNAL_WHISPER_THREADS=            # optional; default cores-1 (max 8)
# JOURNAL_DIR=                        # optional; default data/journal (entries + temporary audio, gitignored)
# JOURNAL_MAX_AUDIO_MB=100            # refuse a single recording larger than this
# JOURNAL_INGEST_TIMEOUT_MS=1800000   # the digest's own budget (30 min). NOT AGENT_TIMEOUT_MS,
#                                     # which is 3 min and killed every real entry mid-digest.
# The ten-minute "don't ingest" window and the spelling hints are settings in the Journal view, not env.

# --- Sunday goals review (Studio → Jobs → Sunday goals review) ---
# Reports the week's goals and asks about anything expiring or moved too often. It never
# completes or postpones anything — those are decisions, and postponing moves a counter.
GOALS_REVIEW_ENABLED=false          # seed default; toggle it in Studio → Jobs
GOALS_REVIEW_TIME=18:00             # seed default run time, Sundays, MORNING_BRIEFING_TZ

# --- Plaud Ventures meeting ingest (Studio → Jobs → Plaud action items ingest) ---
PLAUD_MEETINGS_INGEST_ENABLED=false # seed default; toggle it in Studio → Jobs
PLAUD_MEETINGS_INGEST_TIME=08:00    # seed default run time
# PLAUD_MEETINGS_STATE_FILE=         # optional; default data/plaud-meetings-ingest-state.json (gitignored)
# STUDIO_STATE_FILE=                 # optional; default data/studio-state.json (gitignored)

# --- WHOOP sleep sync (Studio → Jobs → WHOOP sleep sync) ---
# Fills the sleep habit's metric (sleep performance + stages) from the official
# WHOOP API. See docs/whoop-sleep-ingest.md. Create an app at developer.whoop.com,
# then click "Connect WHOOP" on the sleep graph in the Habits tab to authorize.
WHOOP_SLEEP_INGEST_ENABLED=false    # seed default; toggle it in Studio → Jobs
WHOOP_SLEEP_INGEST_TIME=11:00       # seed default run time; late enough for the band to have synced
# Client ID/secret can also be entered in Settings -> Integrations.
WHOOP_CLIENT_ID=                    # developer.whoop.com → your app
WHOOP_CLIENT_SECRET=                # OAuth tokens land in secrets/whoop-oauth.json
# WHOOP_REDIRECT_URI=                # optional; default <PUBLIC_URL or http://localhost:<BRIDGE_PORT>>/whoop-oauth/callback
                                    # must match the app's Redirect URI exactly; use the tunnel host if WHOOP rejects loopback
# WHOOP_TOKENS_FILE=                 # optional; default secrets/whoop-oauth.json
# WHOOP_SLEEP_HABIT_ID=              # optional fallback; normally the habit whose metric source is "whoop-sleep"
# WHOOP_SLEEP_DAYS=3                 # nights re-checked each run, so a missed morning heals itself
WHOOP_SLEEP_DATE_MODE=wake          # wake = the morning you woke | night = local date of the start timestamp.
                                    # Use wake if you ever go to bed after midnight: "night" files that sleep and the
                                    # NEXT night on one date, and the second is silently dropped. See the docs.
# WHOOP_SLEEP_VALUE=performance      # which percentage is the headline number: performance | efficiency | consistency

# --- Strava (Settings → Connections → Wearables & fitness) ---
# Rides, runs and every other activity, plus gear odometers — the full v3 API
# behind /api/strava/*, the totem_strava_* MCP tools, the gateway's strava__*
# tools and strava/cli.mjs. See docs/strava.md. Create an API application at
# strava.com/settings/api, then click "Connect Strava" in the dashboard.
#
# Authorization Callback Domain there is a BARE HOSTNAME (no scheme, path or
# port) and there is only one per app. Set it to your tunnel host, not localhost,
# unless you authorize while sitting at this box — the consent screen redirects
# the BROWSER, so localhost means the browser's own machine. Cloudflare Access
# needs no exception for it: the redirect carries the session cookie already in
# that browser.
# Client ID/secret can also be entered in Settings -> Integrations.
STRAVA_CLIENT_ID=                   # strava.com/settings/api → your app
STRAVA_CLIENT_SECRET=               # OAuth tokens land in secrets/strava-oauth.json
# The "Your Access Token"/"Your Refresh Token" shown on that page are a 6-hour
# read-only sample pair for curl. Nothing here uses them; do not paste them in.
# STRAVA_REDIRECT_URI=               # default <PUBLIC_URL or http://localhost:<BRIDGE_PORT>>/strava-oauth/callback
                                    # set it to https://<your-host>/strava-oauth/callback for remote use;
                                    # its host must equal the app's Authorization Callback Domain
# STRAVA_SCOPES=                     # optional; default read,read_all,profile:read_all,profile:write,activity:read_all,activity:write
# STRAVA_TOKENS_FILE=                # optional; default secrets/strava-oauth.json
# STRAVA_CACHE_FILE=                 # optional; default data/strava-activities.json (the local activity mirror)
# Studio → Jobs → Strava sync: keeps that mirror current on an interval so
# "miles this month" answers from disk. Seed defaults only — jobs.json rules after first boot.
STRAVA_SYNC_ENABLED=false
STRAVA_SYNC_INTERVAL_MINUTES=180

# --- Weather (default for Connections → Built-in data → Weather; Open-Meteo, no key) ---
WEATHER_ENABLED=true                # seed default; configure in Connections → Built-in data
# WEATHER_LAT=                      # your latitude, e.g. 40.7128
# WEATHER_LON=                      # your longitude, e.g. -74.0060
# WEATHER_LOCATION=                 # label shown in the brief, e.g. New York, NY

# --- News (default for Connections → Built-in data → News; Google News RSS, no key) ---
NEWS_ENABLED=true                   # seed default; configure in Connections → Built-in data
NEWS_AI_QUERY=artificial intelligence when:1d
NEWS_WORLD_QUERY=world news when:1d
NEWS_MAX_ITEMS=5

# Usage tab (GET /api/usage). Claude + Codex plans are auto-detected from their
# on-disk auth; these only fill what those tools don't store locally.
# Prefer Settings ▸ Usage ▸ Settings, which writes plan/price/renewal per service
# into data/ai-usage.json and takes precedence over everything below.
CURSOR_PLAN=Pro                     # fallback plan name; normally read live from `cursor-agent about`
CLAUDE_SUB_RENEWS_AT=               # optional ISO date, e.g. 2026-07-01 (Claude doesn't persist it)
CURSOR_SUB_RENEWS_AT=               # optional ISO date (Cursor doesn't persist it)

# --- AI usage (live rate limits; GET /api/ai-usage) ---
# Runs inside the bridge (./ai-usage): discovers every Claude/Codex/Cursor profile
# on this box and polls each vendor's real limit windows every 90s. Nothing to
# configure — accounts are auto-discovered. To pin the interval, rename or hide an
# account, or add one discovery misses, use Settings ▸ Usage ▸ Settings; it writes
# data/ai-usage.json, which you can also edit by hand:
#   { "pollIntervalSeconds": 90, "hidden": ["cursor:cursor-default"],
#     "accountNames": { "claude:claude-default": "Claude" },
#     "providers": { "claude": { "name": "Claude", "priceUsd": 100 } } }
# AI_USAGE_CONFIG=                    # override the path to that file
# Claude quota polling is OFF on a new install: it calls an undocumented Anthropic
# usage endpoint and refreshes Claude Code's own login with the client id built
# into Claude Code, writing the rotated token back to ~/.claude. Cursor polling is
# OFF too: it calls Cursor's private usage endpoint with the token cursor-agent
# stores. Codex is read through its own `codex app-server` and is always on.
# Existing installs keep whatever they had. Settings > Usage > Settings has toggles.
# AI_USAGE_CLAUDE_OAUTH=false
# AI_USAGE_CURSOR=false

# NOTE: Google Calendar OAuth client JSON is stored outside env in:
# secrets/google-calendar-oauth-client.json
# The active Cursor backend reads that path from ~/.cursor/mcp.json.

# --- Inbound MCP server (POST /mcp) — external clients: ChatGPT, Claude, Claude Code ---
# Cloud clients cannot use a static bearer token, so Cloudflare Access fronts /mcp
# and acts as the OAuth authorization server. Access injects a signed JWT which the
# bridge verifies itself (the bridge also listens on localhost/tailnet, where Access
# is not in the path, so trusting the proxy alone would leave /mcp bypassable).
#
# All three must be set for JWT auth to work; if any is missing the bridge refuses
# JWT auth entirely and only the bearer token gets in. Get the AUD tag from the
# Access application covering /mcp (Zero Trust > Access controls > Applications).
# ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# ACCESS_MCP_AUD=                     # AUD tag of the /mcp Access application
# ACCESS_ALLOWED_EMAIL=               # the single identity allowed through

# ---- Camera sync -----------------------------------------------------------
# Plug the Olympus XZ-1 in and its new JPEGs come off the card by themselves.
# The pull itself is triggered by udev and needs NOTHING from this file — it runs
# as root and reads /etc/default/totem-camera instead (written by
# camera/install.sh). What's below is only the Totem job that reports on it.
#
# Set up with: sudo camera/install.sh    (then camera/mac/install-mac.sh on the Mac)
# Full spec, and why it's store-and-forward: docs/camera-sync.md
CAMERA_SYNC_ENABLED=false             # seed default; toggle it in Studio → Jobs
CAMERA_SYNC_INTERVAL_MINUTES=15       # an interval, not a time: it answers "did anything
                                      # get plugged in since I last looked". Minimum 5.
# Photos are stuck in staging until the MacBook — the only machine here that can
# reach iCloud Photos — is next awake on the tailnet. A day or two of waiting is
# normal, so the warning is deliberately slow, and throttled once it starts.
# CAMERA_BACKLOG_STALE_HOURS=48       # how long before waiting photos count as stuck
# CAMERA_BACKLOG_NAG_HOURS=12         # how often it may say so again while stuck
# CAMERA_STAGING_DIR=                 # default <checkout owner's home>/Pictures/camera-inbox
                                      # must match /etc/default/totem-camera
# CAMERA_EVENTS_FILE=                 # default data/camera-events.jsonl
# CAMERA_REPORT_STATE_FILE=           # default data/camera-report-state.json

# ---- Notifications (Web Push) ----------------------------------------------
# Generate the pair once with `node notify/cli.mjs keys`, then paste all three.
# Without them Totem still records every notification in the bell and sends
# nothing, and Settings → Notifications says so rather than failing silently.
# Rotating VAPID_PRIVATE_KEY invalidates every existing subscription and every
# device has to re-subscribe — the symptom is silence, not an error.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com   # contact hint for the push services
# NOTIFY_QUEUE_FILE=                  # default data/notification-queue.json
# PUSH_SUBSCRIPTIONS_FILE=            # default data/push-subscriptions.json (secret: an
                                      # endpoint plus its keys can push to the device)
# NOTIFY_LEDGER_FILE=                 # default data/notification-ledger.json
# NOTIFY_FEEDBACK_FILE=               # default data/notification-feedback.jsonl
# DIGEST_ENABLED=false                # the morning + evening digest jobs (first boot only;
                                      # after that data/jobs.json is authoritative)
# DIGEST_MORNING_TIME=07:15
# DIGEST_MIDDAY_TIME=12:30
# FEED_SCAN_ENABLED=false             # world/good news roundups, releases, AI news, people you follow (every 2h, 07:00-22:00)
                                      # A release this box is behind also stages a confirm-only
                                      # update proposal in the inbox, and the push links to it.
# TIMEX_COLLAB_WATCH_ENABLED=false   # daily news scan for Timex collaborations (first boot only)
# NOTIFY_USAGE_LOW_PCT=80             # how full a quota window has to be before "running low" is
                                      # worth a push. To silence quota nudges entirely, turn the
                                      # category off in Settings -> Notifications rather than
                                      # setting this to 100.
# DIGEST_EVENING_TIME=20:30
# DIGEST_AI_BUDGET_MS=90000           # how long the wording call may take before the
                                      # collectors' own template wording ships instead
# The two pushes around an iOS Shortcut request: a receipt the moment it lands
# (no AI — it has to be instant), then a one-line summary of the answer. On by
# default; it only ever speaks in response to something you just did.
# SHORTCUT_NOTIFY=true
# SHORTCUT_SUMMARY_MODEL=haiku        # pinned cheap, on purpose — this is a rewrite of
                                      # text the expensive model has already produced
# SHORTCUT_SUMMARY_BUDGET_MS=60000    # past this, the answer's own opening ships instead

# --- Realtime voice (chat/voice.mjs) -------------------------------------------
# An OpenAI *API* key (platform.openai.com; ChatGPT Plus does not include API use)
# turns voice mode into the ChatGPT-style speech-to-speech one: interruptible,
# natural voice, and it uses Totem's tools while you talk. Unset = the free local
# whisper.cpp voice mode. Roughly 2-10 cents a conversation on the mini model.
# OPENAI_API_KEY=
# VOICE_REALTIME_MODEL=gpt-realtime-2.1-mini   # or gpt-realtime-2.1 (about 3x)
# VOICE_REALTIME_VOICE=marin                    # marin and cedar sound best
# ---- Optional sibling apps ---------------------------------------------------
# Totem works on its own. Set these only if you also run the Bushido training app.
# BUSHIDO_URL=https://bushido.example.com   # adds "Show in Bushido" to goal cards
# BUSHIDO_LEGACY_HOSTS=                     # comma-separated earlier hostnames whose saved
                                            # goal links should still count as linked

# ---- Voice journal spelling hints ----------------------------------------------
# JOURNAL_VOCABULARY=Totem, Plaud, Strava    # default hints until you save your own
                                             # in the Journal view
